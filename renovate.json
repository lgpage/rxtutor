{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "labels": [
        "linting"
      ],
      "matchPackageNames": [
        "/eslint/"
      ]
    },
    {
      "matchDepTypes": [
        "optionalDependencies"
      ],
      "addLabels": [
        "optional"
      ]
    }
  ],
  "schedule": [
    "before 6am"
  ],
  "configMigration": true,
  "rangeStrategy": "bump",
  "dependencyDashboard": {
    "title": "chore(deps): dependency dashboard"
  }
}
